# Installation MANUELLE par l'administrateur, apres verification des regles existantes.
# Aucun flush ruleset. Les elements temporaires ne doivent pas etre sauvegardes.
table inet cyberpme_guard {
    set blocked_v4 {
        type ipv4_addr
        flags timeout
        timeout 15m
    }
    chain input {
        type filter hook input priority -5; policy accept;
        ct state new ip saddr @blocked_v4 tcp dport != { 22, 3389, 5985, 5986 } drop
    }
}
