POSTGRES_DB=cyberpme
POSTGRES_USER=cyberpme
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+psycopg://cyberpme:change-me-in-production@database:5432/cyberpme
# Browser: same-origin /api proxy. Agents use the separate HTTPS API address.
VITE_AGENT_API_URL=https://cyberpme-demo-api.vercel.app
MFA_REQUIRED=true
# Generate a Fernet key offline; keep it in the deployment secret manager.
MFA_ENCRYPTION_KEY=
ALLOW_LEGACY_ENROLLMENT=false
SESSION_HOURS=8
AGENT_TOKEN_DAYS=90
# false is ONLY for local HTTP development; production must use true.
SECURE_COOKIES=false
ALERT_EMAIL_FROM=alerts@cyberpme.local
ALERT_EMAIL_TO=bocorodrigue43@mail.com
FRONTEND_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Pour un vrai fournisseur SMTP, remplacez les valeurs ci-dessous.
# Ne partagez jamais ce fichier et ne le placez pas dans Git.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
AGENT_ENROLLMENT_KEY=replace-with-a-long-random-secret
BOOTSTRAP_ORGANIZATION_NAME=CyberPME Lab
BOOTSTRAP_ORGANIZATION_SLUG=cyberpme-lab
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
